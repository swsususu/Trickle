{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trickle",
  "version": "0.0.3",
  "identifier": "com.swsususu.trickle",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "",
        "width": 1000,
        "height": 600,
        "titleBarStyle": "Overlay"
      },
      {
        "label": "popover",
        "url": "popover.html",
        "width": 352,
        "height": 224,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true,
        "alwaysOnTop": true,
        "decorations": false,
        "resizable": false,
        "visible": false,
        "transparent": true,
        "focus": false
      },
      {
        "label": "settings",
        "create": false,
        "url": "settings.html",
        "titleBarStyle": "Overlay",
        "title": "Settings",
        "width": 700,
        "height": 800,
        "visible": false
      }
    ],
    "security": {}
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/swsususu/Trickle/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY5ODJDQjYwQzAxNTE4N0UKUldSK0dCWEFZTXVDK1lUNHhqd3Y3Mk1Hd2pkZW4xQVRTTjR2WEQ4enpRVG5BbmUybjBicnFWV1gK"
    }
  }
}
